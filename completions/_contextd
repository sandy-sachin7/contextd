    local commands; commands=()
    _describe -t commands 'contextd help daemon commands' commands "$@"
}
(( $+functions[_contextd__subcmd__help__subcmd__help_commands] )) ||
_contextd__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'contextd help help commands' commands "$@"
}
(( $+functions[_contextd__subcmd__help__subcmd__mcp_commands] )) ||
_contextd__subcmd__help__subcmd__mcp_commands() {
    local commands; commands=()
    _describe -t commands 'contextd help mcp commands' commands "$@"
}
(( $+functions[_contextd__subcmd__help__subcmd__query_commands] )) ||
_contextd__subcmd__help__subcmd__query_commands() {
    local commands; commands=()
    _describe -t commands 'contextd help query commands' commands "$@"
}
(( $+functions[_contextd__subcmd__help__subcmd__setup_commands] )) ||
_contextd__subcmd__help__subcmd__setup_commands() {
    local commands; commands=()
    _describe -t commands 'contextd help setup commands' commands "$@"
}
(( $+functions[_contextd__subcmd__mcp_commands] )) ||
_contextd__subcmd__mcp_commands() {
    local commands; commands=()
    _describe -t commands 'contextd mcp commands' commands "$@"
}
(( $+functions[_contextd__subcmd__query_commands] )) ||
_contextd__subcmd__query_commands() {
    local commands; commands=()
    _describe -t commands 'contextd query commands' commands "$@"
}
(( $+functions[_contextd__subcmd__setup_commands] )) ||
_contextd__subcmd__setup_commands() {
    local commands; commands=()
    _describe -t commands 'contextd setup commands' commands "$@"
}

if [ "$funcstack[1]" = "_contextd" ]; then
    _contextd "$@"
else
    compdef _contextd contextd
fi
